# --- Random Forest ---#
def random_forest_pipeline(X_train, Y_train, X_test, Y_test):
    """
    Full Random Forest pipeline:
    - 
    """ 
    rf = RandomForestRegressor(
        n_estimators=300,
        random_state=42,
        max_depth=None
    )

    # Train model
    rf.fit(X_train, Y_train)
    Y_pred_rf = rf.predict(X_test)

    mse = mean_squared_error(Y_test, Y_pred_rf)
    rmse = np.sqrt(mse)
    mae = mean_absolute_error(Y_test, Y_pred_rf)

    y_true_flat = Y_test.ravel()
    y_pred_flat = Y_pred_rf.ravel()

    pearson = pearsonr(y_true_flat, y_pred_flat)[0]
    spearman = spearmanr(y_true_flat, y_pred_flat)[0]

    print("Random Forest Results")
    print("----------------------")
    print(f"RMSE: {rmse:.4f}")
    print(f"MAE: {mae:.4f}")
    print(f"Pearson: {pearson:.4f}")
    print(f"Spearman: {spearman:.4f}")

    return {
        "model": rf,
        "Y_pred_rf": Y_pred_rf,
        "rmse": rmse,
        "mae": mae,
        "pearson": pearson,
        "spearman": spearman
    }

#Results

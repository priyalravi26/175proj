def test_full_ml_pipeline():

    # -----------------------------
    # 1. Load data
    # -----------------------------
    data = load_and_prepare_data(
        os.path.join(DATA_DIR, "primary-screen-replicate-collapsed-logfold-change.csv"),
        os.path.join(DATA_DIR, "biomarkers.csv")
    )
    # -----------------------------
    # 2. PCA pipeline
    # -----------------------------
    pca_results = pca_biplot_pipeline(
        data["Y_matrix"],
        data["X_final"],
        data["metadata"]
    )

    drug_df = pca_results["drug_df"]

    # -----------------------------
    # 3. Random Forest pipeline
    # -----------------------------
    rf_results = random_forest_pipeline(
        data["X_train"],
        data["Y_train"],
        data["X_test"],
        data["Y_test"]
    )

    rf_model = rf_results["model"]

    # -----------------------------
    # 4. Feature importance
    # -----------------------------
    importance_results = random_forest_importance_pipeline(
        rf_model,
        data["X_final"].columns
    )

    # -----------------------------
    # 5. Overlap analysis
    # -----------------------------
    overlap_results = plsr_rf_overlap_pipeline(
        data["X_final"].columns,
        importance_results["importances"],
        importance_results["importance_df"]
    )

    # -----------------------------
    # 6. Basic assertions (core tests)
    # -----------------------------

    # Data sanity
    assert data["X_train"].shape[0] > 0
    assert data["Y_train"].shape[0] > 0

    # PCA sanity
    assert "PC1" in drug_df.columns
    assert "PC2" in drug_df.columns
    assert drug_df.shape[0] > 0

    # RF sanity
    assert rf_results["rmse"] >= 0
    assert rf_results["mae"] >= 0
    assert -1 <= rf_results["pearson"] <= 1

    # Feature importance sanity
    assert len(importance_results["importances"]) == len(data["X_final"].columns)

    print("✔ FULL INTEGRATION PIPELINE TEST PASSED")

if __name__ == "__main__":
    test_full_ml_pipeline()
